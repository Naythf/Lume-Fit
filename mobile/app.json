{
  "expo": {
    "name": "Lume Fit",
    "slug": "lume-fit",
    "version": "0.1.1",
    "scheme": "lumefit",
    "orientation": "default",
    "icon": "./assets/lume-icon.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      "expo-sharing"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": true,
      "package": "com.lumeproductions.lumefit",
      "versionCode": 2,
      "blockedPermissions": ["android.permission.SYSTEM_ALERT_WINDOW"]
    },
    "web": {
      "favicon": "./assets/lume-icon.png",
      "output": "single"
    }
  }
}
